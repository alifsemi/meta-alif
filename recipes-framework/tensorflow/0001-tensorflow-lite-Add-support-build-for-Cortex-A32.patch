 ...unsupported_arch_files_for_cortexa32.patch | 125 ++++++++++++++++++
 ...ink_libexecinfo_aarch32_armv8a_build.patch |  10 ++
 .../set_correct_default_python_version.patch  |  13 ++
 .../files/set_correct_sizeof_long.patch       |  13 ++
 .../support_aarch32_armv8a_build_1.patch      |  44 ++++++
 .../support_aarch32_armv8a_build_2.patch      |  20 +++
 .../support_aarch32_armv8a_build_3.patch      |  24 ++++
 .../support_aarch32_armv8a_build_4.patch      |  11 ++
 .../tensorflow/tensorflow-lite_%.bbappend     |  45 +++++++
 10 files changed, 337 insertions(+)
