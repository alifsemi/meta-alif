+--- git/tensorflow/lite/kernels/internal/optimized/neon_tensor_utils.cc.orig	2025-11-30 16:28:54.212116014 +0530
++++ git/tensorflow/lite/kernels/internal/optimized/neon_tensor_utils.cc	2025-11-30 16:29:26.004285621 +0530
+@@ -2347,7 +2347,7 @@ void NeonVectorScalarMultiply(const int8
+ // TODO(b/185850916): Consider changing the rounding stragey from "ties to away"
+ // to "ties to even" since vcvtnq_s32_f32 is generally more available.
+ inline int32x4_t RoundToNearest(const float32x4_t input) {
